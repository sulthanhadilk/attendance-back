PORT=5000

# MongoDB Atlas connection string (no real creds here)
MONGO_URI=

# JWT signing secret (set in Render dashboard)
JWT_SECRET=

# Frontend origin for CORS (e.g., https://your-app.vercel.app)
FRONTEND_URL=

# Optional feature flags (no external AI services)
TEACHER_AI_ENABLED=true
ADMIN_AI_ENABLED=true

# One-time bootstrap admin (used only by scripts/createAdmin.js)
ADMIN_EMAIL=
ADMIN_PASSWORD=
